# Configuración del servidor de Avelu y Amara. En la VM vive en /etc/avelu/avelu.env (permisos 600).
# NUNCA subas este archivo con datos reales a GitHub.

PORT=8787
HOST=127.0.0.1
# páginas que pueden usar el servidor (separadas por comas)
ORIGENES=https://jherreraxp.github.io
DATA_DIR=/var/lib/avelu

# correos que siempre tienen el plan familia gratis (por ejemplo, tu familia)
PLAN_GRATIS_PARA=

# Cuentos con IA (opcional). Crea la llave en https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
LIMITE_IA_DIA=5

# Pagos: mercadopago | paypal | ninguno
PAGOS_PROVEEDOR=ninguno

# Mercado Pago (https://www.mercadopago.com.pe/developers/panel → Credenciales de producción)
MP_ACCESS_TOKEN=
MP_PLAN_PRECIO=19.90
MP_MONEDA=PEN
MP_BACK_URL=https://jherreraxp.github.io/Demo2/cuenta.html

# PayPal (https://developer.paypal.com → Apps & Credentials; crea un plan de suscripción mensual)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_MODE=sandbox
PAYPAL_BACK_URL=https://jherreraxp.github.io/Demo2/cuenta.html
