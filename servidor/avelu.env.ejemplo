# Configuración del servidor de Avelu y Amara. En la VM vive en /etc/avelu/avelu.env (permisos 600).
# NUNCA subas este archivo con datos reales a GitHub.

PORT=8787
HOST=127.0.0.1
# páginas que pueden usar el servidor (separadas por comas)
ORIGENES=https://jherreraxp.github.io
DATA_DIR=/var/lib/avelu

# correos que siempre tienen el plan familia gratis (por ejemplo, tu familia)
PLAN_GRATIS_PARA=

# Entrar con Google (opcional). Es el "ID de cliente" (no el secreto) de un cliente OAuth "Aplicación web"
# creado en https://console.cloud.google.com/apis/credentials con origen https://abu.arcillita.com
GOOGLE_CLIENT_ID=

# Cuentos con IA (opcional). Sirve la llave de cualquier proveedor:
#   anthropic (Claude) · gemini · openai · openrouter · groq · deepseek · mistral · xai · ollama · custom
# IA_MODELO es opcional (cada proveedor tiene uno por defecto). IA_BASE_URL solo para "custom"
# (cualquier API compatible con OpenAI) o para cambiar la dirección de un compatible.
IA_PROVEEDOR=
IA_API_KEY=
IA_MODELO=
IA_BASE_URL=
# máximo de cuentos con IA por familia al día, y largo máximo de cada respuesta
IA_LIMITE_DIARIO=10
IA_MAX_TOKENS=1500
# (compatibilidad) si solo existe ANTHROPIC_API_KEY, se usa Claude con ella
ANTHROPIC_API_KEY=

# Pagos: mercadopago | paypal | ninguno
PAGOS_PROVEEDOR=ninguno

# Mercado Pago (https://www.mercadopago.com.pe/developers/panel → Credenciales de producción)
MP_ACCESS_TOKEN=
MP_PLAN_PRECIO=19.90
MP_MONEDA=PEN
MP_BACK_URL=https://jherreraxp.github.io/Demo2/cuenta.html

# PayPal (https://developer.paypal.com → Apps & Credentials; crea un plan de suscripción mensual)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_MODE=sandbox
PAYPAL_BACK_URL=https://jherreraxp.github.io/Demo2/cuenta.html
